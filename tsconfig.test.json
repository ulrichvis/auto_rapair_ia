{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/i18n/**/*.test.ts",
    "src/i18n/locale.ts",
    "src/i18n/messages/*.json",
    "src/lib/extraction/**/*.ts"
  ]
}

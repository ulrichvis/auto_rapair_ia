# Supabase transaction pooler connection string for application runtime queries.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase direct connection string for Prisma CLI operations and migrations.
DIRECT_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase project URL used only by server-side Storage operations.
SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Supabase service-role key. Server-only: never prefix with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Existing private Storage bucket used for original PDF documents.
SUPABASE_PDF_BUCKET="technical-pdfs"
